[flake8]
# ruff est l'autorité de style du projet : `[tool.ruff.lint]` sélectionne
# E, F, W, I, B, UP, SIM à 79 colonnes. Le défaut de flake8 est E, F, W, C.
# Le seul contrôle que flake8 apporte et que ruff ne fait pas est donc `C`
# (complexité) — ruff a `C90`, mais il n'est pas sélectionné, voir #56.
#
# Laisser flake8 rejouer E, F et W ne produisait aucun signal neuf, seulement
# neuf désaccords avec ruff sur des exemptions que ruff applique exprès :
#   - E501 × 5 : lignes dont le dépassement est un jeton insécable (URL de
#     CDN, hash d'intégrité SRI dans un appel `htpy`). ruff ne signale pas
#     une ligne qu'aucune coupure ne peut raccourcir ; flake8 n'a pas cette
#     notion.
#   - F401 × 2 : `from ._server import *` dans un `__init__.py`. ruff traite
#     les ré-exports de module d'index à part ; flake8 les voit inutilisés.
# Le projet ne peut pas satisfaire les deux à la fois sans réécrire du code,
# ce que le périmètre interdit. On garde donc le seul contrôle utile.
select = C901
max-complexity = 20

# `pyplet/client/__init__.py` porte deux fonctions à 24 et 38 de complexité.
# Le seuil reste à 20 pour tout le reste du dépôt ; ce fichier est exempté
# le temps du découpage suivi par #56, pas au-delà.
per-file-ignores =
    pyplet/client/__init__.py:C901
